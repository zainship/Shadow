# GEMINI_API_KEY: Required for Gemini AI API calls (voice, TTS, visuals, research grounding).
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------------------
# BYOK (Bring Your Own Key) — optional; the app UI (AI Provider settings) can
# also carry per-user keys via request headers, which override these values.
# ---------------------------------------------------------------------------

# Force the default provider when a client does not send its own: gemini | openrouter
AI_PROVIDER="gemini"

# OpenRouter fallback key + default model (used when the client has no BYOK key)
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openai/gpt-4o-mini"

# Optional ElevenLabs ultra-fast TTS key + default voice id (used first when configured)
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID=""

# ---------------------------------------------------------------------------
# Latency tuning — model selection & thinking levels (defaults in brackets)
# ---------------------------------------------------------------------------

# Text command endpoint (/api/assistant/command): fast model first by default.
SHADOW_FAST_MODEL="gemini-3.1-flash-lite"
# Opt-in deep model: set SHADOW_USE_DEEP_COMMAND=1 (or send preferDeep:true per request).
SHADOW_DEEP_MODEL="gemini-4-hydrogen"
SHADOW_USE_DEEP_COMMAND="0"

# Voice live session model + thinking level (minimal = lowest first-audio latency).
# Set SHADOW_LIVE_THINKING=off to omit thinkingConfig entirely.
SHADOW_LIVE_MODEL="gemini-3.8-live"
SHADOW_LIVE_THINKING="minimal"

# Speech synthesis & research models
SHADOW_TTS_MODEL="gemini-3.8-flash-lite-tts"
SHADOW_RESEARCH_MODEL="gemini-4-hydrogen"

# ---------------------------------------------------------------------------
# Morning Brief scheduler (server/brief.ts) — automatic scheduled runs use the
# server env keys above (AI_PROVIDER / GEMINI_API_KEY / OPENROUTER_API_KEY).
# Manual "Run now" runs honor client BYOK headers from AI Provider settings.
# State persists to ./data/brief-store.json (gitignored).
# ---------------------------------------------------------------------------

# Optional Playwright headless Chromium runtime or remote WebSocket endpoint
PLAYWRIGHT_WS_ENDPOINT=""
CHROMIUM_EXECUTABLE_PATH=""

# Optional GitHub Personal Access Token for private repos & higher DevOps API limits
GITHUB_TOKEN=""

# Optional Messaging Bridges (can also be configured in Remote Triggers UI)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_DEFAULT_CHAT_ID=""
DISCORD_WEBHOOK_URL=""
SLACK_WEBHOOK_URL=""

# Optional Inbound Webhook signing & extra allowed origins for Cloud Run remote UI
WEBHOOK_SIGNING_SECRET=""
CORS_ALLOWED_ORIGINS=""

